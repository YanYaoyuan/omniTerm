{
  "name": "omniterm-desktop",
  "version": "0.0.1",
  "private": true,
  "productName": "omniTerm",
  "description": "Cross-platform terminal workspace with omniTerm Agent",
  "license": "Apache-2.0",
  "type": "module",
  "main": "build/main.mjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test": "node --test electron/*.test.mjs src/*.test.mjs",
    "test:native": "cargo test --locked --manifest-path native/terminal-host/Cargo.toml",
    "test:pty": "node scripts/test-pty.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.1.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YanYaoyuan/omniTerm.git",
    "directory": "omniterm-desktop"
  }
}
