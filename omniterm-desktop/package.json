{
  "name": "omniterm-desktop",
  "version": "0.1.0",
  "private": true,
  "productName": "omniTerm",
  "description": "Cross-platform terminal workspace with a local Codex Agent",
  "license": "Apache-2.0",
  "type": "module",
  "main": "build/main.mjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "test": "node --test electron/*.test.mjs",
    "test:pty": "node scripts/test-pty.mjs"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "@electron/rebuild": "4.2.1",
    "@electron/packager": "20.3.0",
    "vite": "8.3.5",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@phosphor-icons/react": "2.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YanYaoyuan/omniTerm.git",
    "directory": "omniterm-desktop"
  }
}
